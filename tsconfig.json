
{
   "files": ["src/index.ts"],
   "compilerOptions": {
      "allowUnreachableCode": false,
      "allowUnusedLabels": false,
      "noImplicitReturns": true,
      //"noUncheckedIndexedAccess": true,
      "strict": true,
      "declaration": true,
      "noEmitOnError": true,
      "rootDir": "./src",
      "outDir": "./dist/",
      "module": "commonjs",
      "emitDeclarationOnly": true,
      "exactOptionalPropertyTypes": true,
      "removeComments": true,
      "target": "ES2022",
      "types": ["node"],
      "lib": ["ES2022", "DOM"],
      "newLine": "lf"
   }
}