{
   "name": "the-conlangers-suite",
   "version": "1.1.0",
   "description": "Vocabulary generator and sound change applier",
   "author": "Neonnaut",
   "license": "MIT",
   "homepage": "https://neonnaut.neocities.org/",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/Neonnaut/the-conlangers-suite.git"
   },
   "bugs": {
      "url": "https://github.com/Neonnaut/the-conlangers-suite/issues"
   },
   "keywords": [
      "conlang",
      "word generator",
      "wordgen",
      "words",
      "vocabulary",
      "vocabug",
      "nesca",
      "sound change applier"
   ],
   "scripts": {
      "build": "node build.mjs",
      "lint": "eslint ./ --fix",
      "format": "prettier --write 'src/**/*.{ts,js,json,md}'",
      "test": "vitest run",
      "build:ts": "tsc && vite build",
      "build:win": "tsc.cmd",
      "dev-vocabug": "vite --config app/vocabug/vite.config.ts",
      "dev-nesca": "vite --config app/nesca/vite.config.ts",
      "build:app-vocabug": "vite build --config app/vocabug/vite.config.ts",
      "build:app-nesca": "vite build --config app/nesca/vite.config.ts",
      "build:cli-vocabug": "tsdown bin/src/vocabug.ts --format esm --no-dts --minify --target node18 --out-dir bin/dist --clean false",
      "build:cli-nesca": "tsdown bin/src/nesca.ts --format esm --no-dts --minify --target node18 --out-dir bin/dist --clean false",
      "build:cm6-vocabug": "cd codemirror && npx rollup src/editor.ts -f iife -o ../app/vocabug/dist/cm6.bundle.js -p @rollup/plugin-node-resolve -p @rollup/plugin-typescript --output.name cm6",
      "build:cm6-nesca": "cd codemirror && npx rollup src/editor.ts -f iife -o ../app/nesca/dist/cm6.bundle.js -p @rollup/plugin-node-resolve -p @rollup/plugin-typescript --output.name cm6"
   },
   "devDependencies": {
      "@eslint/js": "^9.37.0",
      "@types/node": "^24.19.2",
      "eslint": "^9.37.0",
      "globals": "^16.4.0",
      "jiti": "^2.6.1",
      "prettier": "3.6.2",
      "rollup": "^4.53.5",
      "terser": "^5.44.0",
      "tsdown": "0.22.14",
      "typescript": "~5.8.3",
      "typescript-eslint": "^8.46.0",
      "vite": "^6.3.5",
      "vite-plugin-banner": "^0.8.1",
      "vite-plugin-dts": "^5.1.2",
      "vitest": "^5.0.5"
   },
   "dependencies": {
      "commander": "^15.0.0"
   },
   "main": "./dist/the-conlangers-suite.cjs.js",
   "module": "./dist/the-conlangers-suite.es.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/the-conlangers-suite.es.js",
         "require": "./dist/the-conlangers-suite.cjs.js"
      }
   },
   "files": [
      "dist",
      "bin/dist",
      "LICENSE",
      "README"
   ],
   "bin": {
      "vocabug": "./bin/dist/vocabug.mjs",
      "nesca": "./bin/dist/nesca.mjs"
   }
}
